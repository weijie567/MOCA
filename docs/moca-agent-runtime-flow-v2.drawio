          <mxGeometry x="830" y="210" width="230" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="contextual" value="&lt;b&gt;04　contextual_intent_resolve&lt;/b&gt;&lt;br&gt;意图 · 操作 · 候选槽位&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;LLM · 最多 2 次尝试&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=2;fontFamily=PingFang SC;fontSize=11;fontColor=#4C1D95;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
