        </mxCell>
        <mxCell id="investigate" value="&lt;b&gt;07　investigate&lt;/b&gt;&lt;br&gt;有界 Tool 调查循环&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;业务事实 · 知识 · 案例记忆&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;fontFamily=PingFang SC;fontSize=11;fontColor=#164E63;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="1130" y="425" width="250" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="rag" value="&lt;b&gt;08　rag_context_build&lt;/b&gt;&lt;br&gt;按需构建并验证证据上下文&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;verified / partial / fail-closed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06B6D4;strokeWidth=1.8;fontFamily=PingFang SC;fontSize=11;fontColor=#164E63;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="820" y="425" width="240" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="recommendation" value="&lt;b&gt;09　recommendation_generation&lt;/b&gt;&lt;br&gt;生成建议与候选动作&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;LLM · 最多 2 次尝试&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=2;fontFamily=PingFang SC;fontSize=11;fontColor=#4C1D95;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="470" y="425" width="280" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="claim" value="&lt;b&gt;10　claim_verify&lt;/b&gt;&lt;br&gt;校验声明与动作证据&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;阻断未验证的动作路径&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06B6D4;strokeWidth=1.8;fontFamily=PingFang SC;fontSize=11;fontColor=#164E63;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="150" y="425" width="250" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="risk" value="&lt;b&gt;11　risk_gate&lt;/b&gt;&lt;br&gt;风险与审批策略决策&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;LLM · 最多 2 次尝试&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=2;fontFamily=PingFang SC;fontSize=11;fontColor=#4C1D95;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="150" y="680" width="250" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="approval" value="&lt;b&gt;13　approval_gate&lt;/b&gt;&lt;br&gt;人工审批中断与恢复&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;interrupt / Command(resume)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontFamily=PingFang SC;fontSize=11;fontColor=#9A3412;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="500" y="680" width="250" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="action" value="&lt;b&gt;14　action_draft&lt;/b&gt;&lt;br&gt;经 ToolPlatform 持久化动作草稿&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;不直接执行外部副作用&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.8;fontFamily=PingFang SC;fontSize=11;fontColor=#9A3412;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="850" y="680" width="250" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="final" value="&lt;b&gt;15　final_response&lt;/b&gt;&lt;br&gt;统一生成最终答复与终态&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;确定性模板 · 节点最多 2 次尝试&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=2;fontFamily=PingFang SC;fontSize=11;fontColor=#4C1D95;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="1200" y="680" width="250" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="clarification" value="&lt;b&gt;12　clarification_gate&lt;/b&gt;&lt;br&gt;收敛需要补充的信息&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;入口来源见页底说明&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.7;dashed=1;dashPattern=5 4;fontFamily=PingFang SC;fontSize=11;fontColor=#334155;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
          <mxGeometry x="1200" y="810" width="250" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="END" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=PingFang SC;fontSize=12;fontStyle=1;fontColor=#166534;align=center;verticalAlign=middle;" vertex="1" parent="components">
          <mxGeometry x="1545" y="692" width="70" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="note-clarification" value="&lt;b&gt;澄清路径&lt;/b&gt;&lt;br&gt;safety_pre_route、contextual_intent_resolve、slot_resolution_gate、investigate、rag_context_build&lt;br&gt;在信息不足或不可信时进入 clarification_gate，再统一进入 final_response" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.3;fontFamily=PingFang SC;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="components">
          <mxGeometry x="60" y="930" width="560" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="note-final" value="&lt;b&gt;Fail-closed 安全收口&lt;/b&gt;&lt;br&gt;调查 / RAG 无证据或异常，建议 / 声明校验不通过，风险被阻断，审批拒绝或无效，动作草稿失败&lt;br&gt;这些重复分支均直接进入 final_response，本图不重复绘制全部回退线" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.3;fontFamily=PingFang SC;fontSize=11;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="components">
          <mxGeometry x="650" y="930" width="570" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="note-approval" value="&lt;b&gt;审批语义&lt;/b&gt;&lt;br&gt;pending：approval_gate 自环　·　edit + superseded：返回 risk_gate 重评&lt;br&gt;批准：进入 action_draft　·　拒绝 / 无效：进入 final_response&lt;br&gt;API 保存审批决定后，通过 Command(resume=...) 恢复同一检查点" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=1.3;fontFamily=PingFang SC;fontSize=11;fontColor=#9A3412;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="components">
          <mxGeometry x="1250" y="930" width="600" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="source-note" value="代码依据：src/agent/graph.py::build_graph() · src/agent/routing.py · src/agent/nodes/approval_gate.py · src/api/routers/approvals.py · 当前工作树 2026-08-04；START / END 为 LangGraph 哨兵，不计入 15 个注册节点" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=10;fontColor=#64748B;" vertex="1" parent="components">
          <mxGeometry x="60" y="1080" width="1790" height="30" as="geometry"/>
