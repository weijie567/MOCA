        </mxCell>

        <mxCell id="memory" value="&lt;b&gt;06　memory_context_load&lt;/b&gt;&lt;br&gt;按需加载长期偏好与已审核案例&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;上下文用途，不授予动作权限&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.8;fontFamily=PingFang SC;fontSize=11;fontColor=#1E3A8A;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="components">
