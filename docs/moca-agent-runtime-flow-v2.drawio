        <mxCell id="receive" value="&lt;b&gt;01　receive_request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;接收并规范化请求&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.7;fontFamily=PingFang SC;fontSize=12;fontColor=#1E3A8A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="components">
