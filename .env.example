DATABASE_URL=postgresql+asyncpg://moca:moca_dev@localhost:5432/moca
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-in-prod-32-bytes-min
JWT_EXPIRE_MINUTES=60
