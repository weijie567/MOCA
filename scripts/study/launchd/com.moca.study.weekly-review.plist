<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moca.study.weekly-review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/ming/projects/MOCA/scripts/study/weekly_review.py</string>
    <string>--week</string>
    <string>auto</string>
    <string>--codex</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ming/projects/MOCA</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/moca-study-weekly-review.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/moca-study-weekly-review.err</string>
</dict>
</plist>
